# stable-diffusion.cpp, which carries ggml and the libraries of its image and
# video files as submodules of its own; the patches of patches/ go into it and
# into its ggml when CMake configures (cmake/Patches.cmake).

[submodule "thirdparty/stable-diffusion.cpp"]
	path = thirdparty/stable-diffusion.cpp
	url = https://github.com/leejet/stable-diffusion.cpp.git
