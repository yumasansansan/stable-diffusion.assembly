 #include "ggml-backend.h"
 #include "model/common/ggml_block.hpp"
 
+#ifdef SD_USE_SDASM
+#include "sdasm.h"
+
+// The tokens of a grid of w by h, x [N, w * h, C], at every factor-th column
+// of every factor-th row from the first: [N, ceil(w / factor) * ceil(h /
+// factor), C], the token nearest each point of the coarser grid.
+static inline ggml_tensor* sdasm_coarser_tokens(ggml_context* ctx, ggml_tensor* x, int64_t w, int64_t h, int factor) {
+    const int64_t c     = x->ne[0];
+    const int64_t n     = x->ne[2];
+    const int64_t w2    = (w + factor - 1) / factor;
+    const int64_t h2    = (h + factor - 1) / factor;
+    ggml_tensor* grid   = ggml_reshape_4d(ctx, x, c, w, h, n);
+    ggml_tensor* coarse = ggml_view_4d(ctx, grid, c, w2, h2, n, factor * grid->nb[1], factor * grid->nb[2], grid->nb[3], 0);
+    return ggml_reshape_3d(ctx, ggml_cont(ctx, coarse), c, w2 * h2, n);
+}
+#endif
+
 class DownSampleBlock : public GGMLBlock {
 protected:
     int channels;
