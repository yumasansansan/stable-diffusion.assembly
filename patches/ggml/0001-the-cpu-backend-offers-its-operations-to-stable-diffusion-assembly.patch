+// stable-diffusion.assembly computes the operations it has kernels for, with
+// the functions its header declares (sources/sdasm.h of that project, which
+// builds them into this library, and gives it the header with them): the
+// calls here and the definitions there are held to the same declarations.
+#include "sdasm.h"
+
 static void ggml_compute_forward(struct ggml_compute_params * params, struct ggml_tensor * tensor) {
     GGML_ASSERT(params);
 
@@ -1903,6 +1909,10 @@
         return;
     }
 
+    if (sdasm_compute_forward(params, tensor)) {
+        return;
+    }
+
     // extra_buffer op?
     if (ggml_cpu_extra_compute_forward(params, tensor)) {
         return;
@@ -3017,7 +3027,7 @@
 
         size_t cur = 0;
 
-        if (!ggml_cpu_extra_work_size(n_threads, node, &cur)) {
+        if (!sdasm_work_size(node, n_threads, &cur) && !ggml_cpu_extra_work_size(n_threads, node, &cur)) {
             switch (node->op) {
                 case GGML_OP_CPY:
                 case GGML_OP_DUP:
