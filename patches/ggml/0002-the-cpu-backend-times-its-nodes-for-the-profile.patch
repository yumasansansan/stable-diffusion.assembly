The CPU backend times its nodes for stable-diffusion.assembly's profile

When sdasm_profile_enabled() says so -- SDASM_PROFILE is set in the environment -- the first thread of the pool times each node of a graph, from its start to the barrier after it, where the last thread is done with it, and the graph to the barrier at its end, and hands the times to sdasm_profile_node() and sdasm_profile_graph(). stable-diffusion.assembly sums them by operation, by operands and by graph, and writes them out when the program ends (sources/profile.cc). Without the variable, a graph asks once whether to time it and times nothing.

The backend declares the functions and does not define them, as with patch 0001.

This is stable-diffusion.assembly's own patch, applied to the submodule by cmake/Patches.cmake when CMake configures, after patch 0001; it is not for upstream. ggml's part is under the MIT License, and the patch's under the GNU General Public License, version 3 or any later version.

diff --git a/src/ggml-cpu/ggml-cpu.c b/src/ggml-cpu/ggml-cpu.c
index d9aa7a8..ec26c28 100644
--- a/src/ggml-cpu/ggml-cpu.c
+++ b/src/ggml-cpu/ggml-cpu.c
@@ -1900,6 +1900,10 @@ static void ggml_compute_forward_mul_mat_id(
 // (sources/sdasm.h of that project, which builds them into this library).
 bool sdasm_compute_forward(const struct ggml_compute_params * params, struct ggml_tensor * node);
 bool sdasm_work_size(const struct ggml_tensor * node, int n_threads, size_t * size);
+bool sdasm_profile_enabled(void);
+uint64_t sdasm_profile_now(void);
+void sdasm_profile_node(const struct ggml_cgraph * graph, const struct ggml_tensor * node, int fused, uint64_t nanoseconds);
+void sdasm_profile_graph(const struct ggml_cgraph * graph, uint64_t nanoseconds);
 
 static void ggml_compute_forward(struct ggml_compute_params * params, struct ggml_tensor * tensor) {
     GGML_ASSERT(params);
@@ -3314,6 +3318,11 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
     GGML_PRINT_DEBUG("thread #%d compute-start cplan %p last-graph %d\n", state->ith, (const void *)cplan, state->last_graph);
 #endif
 
+    // stable-diffusion.assembly's profile: the first thread times each node
+    // to the barrier after it, and the graph to the barrier at its end.
+    const bool profiling = state->ith == 0 && sdasm_profile_enabled();
+    const uint64_t graph_start = profiling ? sdasm_profile_now() : 0;
+
     for (int node_n = 0; node_n < cgraph->n_nodes && atomic_load_explicit(&tp->abort, memory_order_relaxed) != node_n; node_n++) {
         struct ggml_tensor * node = cgraph->nodes[node_n];
 
@@ -3326,6 +3335,8 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
             continue;
         }
 
+        const uint64_t node_start = profiling ? sdasm_profile_now() : 0;
+
         // TODO: move fused-op detection into ggml_graph_plan so fusion decisions are made once at planning time
         // Try fused ops, fall back to normal compute
         const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, &params, cplan);
@@ -3344,6 +3355,9 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
         if (node_n + 1 < cgraph->n_nodes) {
             ggml_barrier(state->threadpool);
         }
+        if (profiling) {
+            sdasm_profile_node(cgraph, node, n_fused, sdasm_profile_now() - node_start);
+        }
     }
 
 #ifdef GGML_USE_OPENMP
@@ -3353,6 +3367,9 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
 #endif
 
     ggml_barrier(state->threadpool);
+    if (profiling) {
+        sdasm_profile_graph(cgraph, sdasm_profile_now() - graph_start);
+    }
 
 #ifdef GGML_USE_CPU_RISCV64_SPACEMIT
     ggml_backend_cpu_riscv64_spacemit_clear_numa_thread_affinity_threaded(state->ith);
