The type traits call their functions through pointers of their own types

ggml's tables of type traits -- type_traits in ggml.c, type_traits_cpu in ggml-cpu.c -- hold functions that convert rows and take the dot products of vectors of a type, each cast to a pointer of the table's types, of rows and vectors of any type, void *: ggml_vec_dot_f16, which takes vectors of ggml_fp16_t, cast to ggml_vec_dot_t, and so on for 60 functions. A call through a pointer of another type than the function's is undefined in C, and Clang's UBSan reports it (-fsanitize=function, of undefined since Clang 17 in C too): the first matrix product of FP16 weights in ggml's kernels stops a program built with the sanitizers. Each table now holds a wrapper of the pointer's type, which passes its arguments on to the function, the rows and vectors converted from void * to the type that the table's entry is for, as C converts void *. Nothing is cast: ggml_vec_dot_f16 and ggml_vec_dot_bf16, which read their vectors and did not say so, declare them const now, as ggml_vec_dot_f32 does, so that what the tables hand on as const stays const all the way down; their callers in ops.cpp hand them vectors that are not const, which converts by itself.

This is stable-diffusion.assembly's own patch, applied to the submodule by cmake/Patches.cmake when CMake configures, after patch 0004; upstream, the functions could take the tables' types themselves. ggml's part is under the MIT License, and the patch's under the GNU General Public License, version 3 or any later version.

diff --git a/src/ggml-cpu/ggml-cpu.c b/src/ggml-cpu/ggml-cpu.c
--- a/src/ggml-cpu/ggml-cpu.c
+++ b/src/ggml-cpu/ggml-cpu.c
@@ -212,16 +212,48 @@
 #include <TargetConditionals.h>
 #endif
 
+// The functions of the table below, of the types of its pointers. Each of them
+// takes rows or vectors of its own type, and was cast to a pointer of rows and
+// vectors of any type; but a call through a pointer of another type than the
+// function's is undefined, which UBSan's function check reports. Each wrapper
+// has the pointer's type and passes its arguments on, the rows and vectors
+// converted from void * to the type that the table's entry is for, as C
+// converts void *, and what is read stays const.
+static void ggml_cpu_fp32_to_fp32_row_of_any(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t n) {
+    ggml_cpu_fp32_to_fp32(x, y, n);
+}
+static void ggml_cpu_fp32_to_fp16_row_of_any(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t n) {
+    ggml_cpu_fp32_to_fp16(x, y, n);
+}
+static void ggml_cpu_fp32_to_bf16_row_of_any(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t n) {
+    ggml_cpu_fp32_to_bf16(x, y, n);
+}
+static void ggml_cpu_fp32_to_i32_row_of_any(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t n) {
+    ggml_cpu_fp32_to_i32(x, y, n);
+}
+static void ggml_vec_dot_f32_of_any(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT x, size_t bx,
+                                    const void * GGML_RESTRICT y, size_t by, int nrc) {
+    ggml_vec_dot_f32(n, s, bs, x, bx, y, by, nrc);
+}
+static void ggml_vec_dot_f16_of_any(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT x, size_t bx,
+                                    const void * GGML_RESTRICT y, size_t by, int nrc) {
+    ggml_vec_dot_f16(n, s, bs, x, bx, y, by, nrc);
+}
+static void ggml_vec_dot_bf16_of_any(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT x, size_t bx,
+                                     const void * GGML_RESTRICT y, size_t by, int nrc) {
+    ggml_vec_dot_bf16(n, s, bs, x, bx, y, by, nrc);
+}
+
 static const struct ggml_type_traits_cpu type_traits_cpu[GGML_TYPE_COUNT] = {
     [GGML_TYPE_F32] = {
-        .from_float               = (ggml_from_float_t) ggml_cpu_fp32_to_fp32,
-        .vec_dot                  = (ggml_vec_dot_t) ggml_vec_dot_f32,
+        .from_float               = ggml_cpu_fp32_to_fp32_row_of_any,
+        .vec_dot                  = ggml_vec_dot_f32_of_any,
         .vec_dot_type             = GGML_TYPE_F32,
         .nrows                    = 1,
     },
     [GGML_TYPE_F16] = {
-        .from_float               = (ggml_from_float_t) ggml_cpu_fp32_to_fp16,
-        .vec_dot                  = (ggml_vec_dot_t) ggml_vec_dot_f16,
+        .from_float               = ggml_cpu_fp32_to_fp16_row_of_any,
+        .vec_dot                  = ggml_vec_dot_f16_of_any,
         .vec_dot_type             = GGML_TYPE_F16,
         .nrows                    = 1,
     },
@@ -393,8 +425,8 @@
         .from_float               = quantize_row_q8_K,
     },
     [GGML_TYPE_BF16] = {
-        .from_float               = (ggml_from_float_t) ggml_cpu_fp32_to_bf16,
-        .vec_dot                  = (ggml_vec_dot_t) ggml_vec_dot_bf16,
+        .from_float               = ggml_cpu_fp32_to_bf16_row_of_any,
+        .vec_dot                  = ggml_vec_dot_bf16_of_any,
         .vec_dot_type             = GGML_TYPE_BF16,
         .nrows                    = 1,
     },
@@ -411,7 +443,7 @@
         .nrows                    = 1,
     },
     [GGML_TYPE_I32] = {
-        .from_float               = (ggml_from_float_t) ggml_cpu_fp32_to_i32,
+        .from_float               = ggml_cpu_fp32_to_i32_row_of_any,
     },
 };
 
